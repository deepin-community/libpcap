Description: Guard constant BPF shifts by more than 31 bits.
 "lsh x" and "rsh x" already guard against a shift amount of 32 or more, but
 the immediate forms "lsh #k" and "rsh #k" do not: the interpreter shifts by
 an amount that is undefined behaviour in C, which UBSan reports as
   bpf_filter.c: shift exponent 32 is too large for 32-bit type 'unsigned int'
 Programs generated by libpcap never have k > 31, but programs that reach the
 interpreter through pcap_offline_filter() or the deprecated bpf_filter() can
 have any value, so make both the interpreter and the validator handle this
 the same way upstream does.
 The upstream commit rejects such instructions in pcap_valid_insn(), which
 comes from commit 19718105 and is not part of this backport, so its validator
 hunk is applied to the equivalent place in pcap_validate_filter() instead.
Author: Denis Ovsienko <denis@ovsienko.info>
Origin: https://github.com/the-tcpdump-group/libpcap/commit/1d1ea1686d708b33d43f299b449c313aee1b1a33
Last-Update: 2026-09-21
---
diff --git a/CHANGES b/CHANGES
index c58a8a77..c831d584 100644
--- a/CHANGES
+++ b/CHANGES
@@ -7,6 +7,7 @@ Monthday, Month DD, YYYY
       CVE-2026-6554: Limit "ja L" looping in pcap_offline_filter().
       CVE-2026-0799: Access M[] safely in the BPF interpreter.
       CVE-2026-31912: Mind the program bounds in pcap_offline_filter().
+      For "lsh" and "rsh" guard "#k" as well.
     Source code:
       Add PCAP_AVAILABLE_1_11.
       CVE-2025-11961: Fix OOBR and OOBW in pcap_ether_aton().
diff --git a/bpf_filter.c b/bpf_filter.c
index e32b9909..d072f5f6 100644
--- a/bpf_filter.c
+++ b/bpf_filter.c
@@ -407,11 +407,11 @@ DIAG_ON_DEFAULT_ONLY_SWITCH
 			continue;
 
 		case BPF_ALU|BPF_LSH|BPF_K:
-			A <<= pc->k;
+			A = (pc->k < 32) ? A << pc->k : 0;
 			continue;
 
 		case BPF_ALU|BPF_RSH|BPF_K:
-			A >>= pc->k;
+			A = (pc->k < 32) ? A >> pc->k : 0;
 			continue;
 
 		case BPF_ALU|BPF_NEG:
@@ -510,8 +510,16 @@ pcap_validate_filter(const struct bpf_insn *f, int len)
 			case BPF_XOR:
 			case BPF_LSH:
 			case BPF_RSH:
-			case BPF_NEG:
-				break;
+				/*
+				 * Reject a constant shift by more than 31
+				 * bits, the interpreter cannot shift that
+				 * far.
+				 */
+				if (BPF_SRC(p->code) == BPF_K && p->k >= 32)
+					return 0;
+				break;
+			case BPF_NEG:
+				break;
 			case BPF_DIV:
 			case BPF_MOD:
 				/*
diff --git a/optimize.c b/optimize.c
index 610a0303..0d7c71ed 100644
--- a/optimize.c
+++ b/optimize.c
@@ -828,11 +828,7 @@ fold_op(opt_state_t *opt_state, struct stmt *s, bpf_u_int32 v0, bpf_u_int32 v1)
 		 * is undefined in C; we'll just treat it as shifting
 		 * all the bits out.
 		 *
-		 * XXX - the BPF interpreter doesn't check for this,
-		 * so its behavior is dependent on the behavior of
-		 * the processor on which it's running.  There are
-		 * processors on which it shifts all the bits out
-		 * and processors on which it does no shift.
+		 * The BPF interpreter in libpcap does the same.
 		 */
 		if (b < 32)
 			a <<= b;
@@ -846,11 +842,7 @@ fold_op(opt_state_t *opt_state, struct stmt *s, bpf_u_int32 v0, bpf_u_int32 v1)
 		 * is undefined in C; we'll just treat it as shifting
 		 * all the bits out.
 		 *
-		 * XXX - the BPF interpreter doesn't check for this,
-		 * so its behavior is dependent on the behavior of
-		 * the processor on which it's running.  There are
-		 * processors on which it shifts all the bits out
-		 * and processors on which it does no shift.
+		 * The BPF interpreter in libpcap does the same.
 		 */
 		if (b < 32)
 			a >>= b;
